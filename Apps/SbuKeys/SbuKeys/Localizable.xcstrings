      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All on your Mac"
          }
        }
      }
    },
    "Un solo permesso": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One permission"
          }
        }
      }
    },
    "Un suono a ogni tasto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sound for every key"
          }
        }
      }
    },
