# Lanes for Sbu, the one app with the tools as notebook pages (ADR-0027). Run from Apps/Sbu.
# Spike: only internal TestFlight for now, so no metadata, screenshots or release lane yet.
# beta needs an App Store Connect API key in the environment:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (path to the .p8), SBU_TEAM_ID
default_platform(:ios)
import(File.expand_path("../../../Tools/fastlane/Fastfile", __dir__))

platform :ios do
  before_all do
    Dir.chdir("..") { sh("xcodegen", "generate") }
  end

  desc "Unit and UI tests on the simulator"
  lane :test do
    run_tests(scheme: "Sbu", devices: ["iPhone 17"])
  end

  # The App Store Connect API can't create apps, so this lane logs in with the Apple ID in
  # FASTLANE_USER: 2FA the first time, then the session cached in ~/.fastlane/spaceship.
  desc "Register the bundle ID and create the App Store Connect record, Italian primary language"
  lane :create_app do
    produce(
      username: ENV.fetch("FASTLANE_USER"),
      app_name: ENV.fetch("SBU_APP_NAME", "Sbu"),
      language: "Italian",
      sku: "dev.sbu.sbu",
      platform: "ios"
    )
  end

  desc "Build and upload to TestFlight, internal group only"
  lane :beta do
    api_key
    increment_build_number(build_number: latest_testflight_build_number(initial_build_number: 0) + 1, xcodeproj: "Sbu.xcodeproj")
    build_app(scheme: "Sbu", export_method: "app-store", xcargs: signing_args)
    upload_to_testflight(skip_waiting_for_build_processing: true)
    internal_testers
  end

  def signing_args
    "-allowProvisioningUpdates -authenticationKeyPath #{ENV.fetch("ASC_KEY_PATH")} " \
      "-authenticationKeyID #{ENV.fetch("ASC_KEY_ID")} -authenticationKeyIssuerID #{ENV.fetch("ASC_ISSUER_ID")}"
  end

  private_lane :api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end
end
