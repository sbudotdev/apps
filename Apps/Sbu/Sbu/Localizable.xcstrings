            "value": "How to use"
          }
        }
      }
    },
    "Con Zero sui lati, in Impostazioni, un bordo legge 0° sui lati invece che in alto e in basso. Un tocco sulla cifra nasconde i controlli, un altro li mostra.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Zero at the sides, in Settings, an edge reads 0° on the sides instead of the top and bottom. A tap on the figure hides the controls, another shows them."
          }
        }
      }
    },
    "Con i tassi inseriti da te": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the rates you typed"
          }
        }
      }
    },
    "Conclusi": {
      "localizations": {
