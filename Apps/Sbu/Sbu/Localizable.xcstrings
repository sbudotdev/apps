    "Impostato": {
      "comment": "The Closure word when a phase alert is turned on and iOS will deliver it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set"
          }
        }
      }
    },
    "Impostazioni dell'iPhone, il tuo nome in alto, poi Abbonamenti. Ci sono tutti quelli che paghi con l'App Store.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Settings, your name at the top, then Subscriptions. Every one you pay through the App Store is there."
          }
        }
      }
    },
    "In attesa": {
      "localizations": {
        "en": {
