    "x:12": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "x:12"
          }
        }
      }
    },
    "x:12 è l'alzata su 12 di base, come si legge un tetto. 1V:H è la base per 1 di alzata. Con Zero sui lati, un bordo legge 0° sui lati invece che in alto e in basso.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "x:12 is the rise on a run of 12, as a roof is read. 1V:H is the run for a rise of 1. With Zero at the sides, an edge reads 0° on the sides instead of the top and bottom."
          }
        }
      }
    },
