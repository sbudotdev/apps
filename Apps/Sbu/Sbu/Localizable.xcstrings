    },
    "La cifra in alto e il widget mostrano questo periodo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The figure at the top and the widget show this period."
          }
        }
      }
    },
    "La fase di oggi e le prossime": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's phase and the next ones"
          }
        }
      }
    },
    "La lista sparisce da questo iPhone. Chi la condivide la tiene.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list leaves this iPhone. Whoever shares it keeps it."
          }
        }
      }
    },
    "La posizione è disattivata per Sbu Moon. Attivala nelle Impostazioni dell'iPhone, o scegli una città.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is off for Sbu Moon. Turn it on in the iPhone's Settings, or choose a city."
          }
        }
      }
    },
    "La prova finisce domani": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trial ends tomorrow"
          }
        }
      }
    },
    "La prova finisce oggi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trial ends today"
          }
        }
      }
    },
    "La prova finisce tra ^[%lld giorno](inflect: true)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trial ends in ^[%lld day](inflect: true)"
          }
        }
      }
    },
    "La prova gratuita finisce domani. Poi paghi %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free trial ends tomorrow. Then you pay %@."
