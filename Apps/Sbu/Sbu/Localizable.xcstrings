            "state": "translated",
            "value": "Waiting"
          }
        }
      }
    },
    "In bolla": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Level"
          }
        }
      }
    },
    "In pausa": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused"
          }
        }
      }
    },
    "In pausa o annullato non entra nel totale e non ti ricorda i pagamenti.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused or cancelled, it leaves the total and stops reminding you."
          }
        }
      }
    },
    "In piano": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying flat"
          }
        }
      }
    },
    "In sola lettura. Non entra nel tuo totale e non ti manda promemoria.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read only. It's not in your total and sends you no reminders."
          }
        }
      }
    },
