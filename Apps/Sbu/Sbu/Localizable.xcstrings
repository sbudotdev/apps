    "Gira l'iPhone di 180° sullo stesso punto, sullo stesso lato, e tocca Misura.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your iPhone 180° on the same spot, on the same side, and tap Measure."
          }
        }
      }
    },
    "Già presente": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already there"
          }
        }
      }
    },
    "Gli abbonamenti restano, senza categoria.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its subscriptions stay, without a category."
