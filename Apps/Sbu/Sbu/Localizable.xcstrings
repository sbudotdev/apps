    },
    "Gli abbonamenti restano, senza lista.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its subscriptions stay, without a list."
          }
        }
      }
    },
    "Gli abbonamenti vanno nel tuo iCloud e arrivano sui tuoi dispositivi, mai su un server di Sbu. Spento, restano solo su questo iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscriptions go to your iCloud and reach your devices, never a Sbu server. Off, they stay on this iPhone only."
          }
        }
      }
    },
