    "Dorme acciambellata: fai clic per svegliarla. Annusa, fa due passi e torna a dormire.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curled up asleep: click to wake it. It sniffs around, takes a little walk and goes back to sleep."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schläft zusammengerollt: Klick, um ihn zu wecken. Er schnuppert, läuft ein paar Schritte und schläft wieder ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle dort roulée en boule : clique pour la réveiller. Elle renifle, fait quelques pas et se rendort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duerme hecho un ovillo: haz clic para despertarlo. Olfatea, da unos pasos y vuelve a dormirse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "丸くなって眠っています。クリックすると起きて、においをかぎ、少し歩いてまた眠ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorme enrolada: clique para acordá-la. Ela fareja, dá uns passos e volta a dormir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaapt opgerold: klik om hem wakker te maken. Hij snuffelt, loopt een paar stapjes en gaat weer slapen."
          }
        }
      }
    },
    "Fai clic per accendere il fuoco: la finestra si scalda e dal camino esce il fumo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to light the fire: the window glows and smoke rises from the chimney."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klick, um das Feuer anzuzünden: Das Fenster leuchtet warm und aus dem Schornstein steigt Rauch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique pour allumer le feu : la fenêtre se réchauffe et la cheminée fume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para encender el fuego: la ventana se calienta y sale humo de la chimenea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックすると火がつきます。窓が暖かく光り、煙突から煙が出ます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para acender o fogo: a janela se aquece e sai fumaça da chaminé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik om het vuur aan te steken: het venster gloeit warm en uit de schoorsteen komt rook."
          }
        }
      }
    },
    "Fai clic per accenderla o spegnerla.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to light it or put it out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klick, um sie anzuzünden oder zu löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique pour l’allumer ou l’éteindre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para encenderla o apagarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックでつけたり消したりできます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para acender ou apagar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik om hem aan of uit te doen."
          }
        }
      }
    },
    "Fai clic sulla mangiatoia per mettere i semi: arriva la cincia a beccarli.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the feeder to put out seeds: a tit comes to peck at them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klick auf das Futterhaus, um Körner hineinzulegen: Eine Meise kommt und pickt sie auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique sur la mangeoire pour y mettre des graines : une mésange vient les picorer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el comedero para poner semillas: llega el herrerillo a picotearlas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "えさ台をクリックすると種が置かれ、シジュウカラがついばみに来ます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no comedouro para pôr sementes: o chapim vem bicar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op het voederhuisje om zaadjes neer te leggen: er komt een mees om ze op te pikken."
          }
        }
      }
    },
