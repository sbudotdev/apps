    "Prova a portarsi via un pupazzo: fai clic sullo Yeti per scacciarlo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It tries to carry off a snowman: click the Yeti to scare it away."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er versucht, einen Schneemann mitzunehmen: Klick auf den Yeti, um ihn zu verjagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il essaie d’emporter un bonhomme de neige : clique sur le yéti pour le chasser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta llevarse un muñeco de nieve: haz clic en el yeti para espantarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雪だるまを連れ去ろうとします。イエティをクリックして追い払ってください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenta levar um boneco de neve embora: clique no Yeti para espantá-lo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij probeert een sneeuwpop mee te nemen: klik op de yeti om hem weg te jagen."
          }
        }
      }
    },
