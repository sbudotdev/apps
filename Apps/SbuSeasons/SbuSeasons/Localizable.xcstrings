      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome Tour…"
          }
        }
      }
    },
    "Tutte le impostazioni tornano come al primo avvio.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All settings go back to how they were at first launch."
          }
        }
      }
    },
    "Undici effetti": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleven Effects"
          }
        }
      }
    }
