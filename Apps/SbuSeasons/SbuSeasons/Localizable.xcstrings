            "value": "Tirar árvores, neve e trenós"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal bomen, sneeuw en sleeën weg"
          }
        }
      }
    },
    "Togli la funivia": {
