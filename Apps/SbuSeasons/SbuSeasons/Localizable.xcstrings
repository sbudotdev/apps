      }
    },
    "Dietro le finestre: gli effetti restano sulla scrivania, sotto le finestre delle app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Behind Windows: the effects stay on the desktop, under your app windows."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinter den Fenstern: Die Effekte bleiben auf dem Schreibtisch, unter den Fenstern deiner Apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Derrière les fenêtres : les effets restent sur le bureau, sous les fenêtres des apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detrás de las ventanas: los efectos se quedan en el escritorio, debajo de las ventanas de las apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウの後ろ：エフェクトはデスクトップ上、Appのウインドウの下にとどまります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrás das janelas: os efeitos ficam na mesa, embaixo das janelas dos apps."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Achter vensters: de effecten blijven op het bureaublad, onder de vensters van je apps."
          }
        }
      }
    },
