    "Il testo non si salva da nessuna parte: la slitta passa e se lo porta via.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is not saved anywhere: the sleigh comes by and takes it away."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text wird nirgends gespeichert: Der Schlitten kommt vorbei und nimmt ihn mit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte n’est enregistré nulle part : le traîneau passe et l’emporte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto no se guarda en ningún sitio: pasa el trineo y se lo lleva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文章はどこにも保存されません。ソリが通りかかって持っていきます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto não é salvo em lugar nenhum: o trenó passa e o leva embora."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tekst wordt nergens bewaard: de slee komt langs en neemt hem mee."
          }
        }
      }
    },
    "Il trenino passa da solo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Toy Train Comes by Itself"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spielzeugzug kommt von selbst"
          }
