    "Per fare una palla di neve, tieni premuto ⌥ e passa il cursore sulla neve posata.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To make a snowball, hold ⌥ and move the pointer through settled snow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen Schneeball halte ⌥ gedrückt und fahre mit dem Zeiger durch den liegenden Schnee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour faire une boule de neige, maintiens ⌥ et passe le pointeur sur la neige posée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para hacer una bola de nieve, mantén pulsada ⌥ y pasa el puntero por la nieve acumulada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雪玉を作るには、⌥を押したまま積もった雪の上でポインタを動かします。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para fazer uma bola de neve, mantenha ⌥ pressionada e passe o ponteiro pela neve acumulada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om een sneeuwbal te maken houd je ⌥ ingedrukt en beweeg je de aanwijzer door de gevallen sneeuw."
          }
        }
      }
    },
    "Acceso: parte dal Dock. Spento: parte dalla finestra più in alto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: it starts on the Dock. Off: it starts on the highest window."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein: Er startet auf dem Dock. Aus: Er startet auf dem obersten Fenster."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé : il part du Dock. Désactivé : il part de la fenêtre la plus haute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: empieza en el Dock. Desactivado: empieza en la ventana más alta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン：Dockから出発します。オフ：いちばん上のウインドウから出発します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado: começa no Dock. Desativado: começa na janela mais alta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan: hij begint op het Dock. Uit: hij begint op het hoogste venster."
          }
        }
      }
    },
    "Lancia lo slittino trascinandolo, o fai clic per spingerlo: scende di bordo in bordo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the sled to throw it, or click to push it: it slides down from edge to edge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirf den Schlitten, indem du ihn ziehst, oder klick, um ihn anzuschieben: Er rutscht von Kante zu Kante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance la luge en la faisant glisser, ou clique pour la pousser : elle descend de bord en bord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanza el trineo arrastrándolo, o haz clic para empujarlo: baja de borde en borde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソリはドラッグして投げるか、クリックして押してください。縁から縁へと滑り下ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance o trenó arrastando-o, ou clique para empurrá-lo: ele desce de borda em borda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gooi de slee door hem te slepen, of klik om hem een duw te geven: hij glijdt van rand naar rand naar beneden."
          }
        }
      }
    },
    "Manda lo spazzaneve": {
