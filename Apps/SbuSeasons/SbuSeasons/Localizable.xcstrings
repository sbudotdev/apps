          "stringUnit": {
            "state": "translated",
            "value": "Medium"
          }
        }
      }
    },
    "Nata da un'idea di Simone Antoniciello": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on an idea by Simone Antoniciello"
          }
        }
      }
    },
    "Neve": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snow"
          }
        }
      }
    },
    "Neve posata": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settled Snow"
          }
        }
      }
    },
    "Nevicata": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snowfall"
          }
        }
      }
    },
    "Per vedere dov'è il Dock serve il permesso Accessibilità.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see where the Dock is, the app needs Accessibility permission."
          }
        }
      }
    },
    "Più in basso sul Dock": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower on the Dock"
          }
        }
      }
    },
    "Primavera": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring"
          }
        }
      }
    },
    "Quantità di fiocchi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Number of Flakes"
          }
        }
      }
    },
    "Raggio": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Radius"
          }
        }
      }
    },
    "Ripristina": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset"
          }
        }
      }
    },
    "Ripristinare i valori predefiniti?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset to the default values?"
          }
        }
      }
    },
    "Ripristina…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset…"
          }
        }
      }
    },
    "Sciogli la neve": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Melt the Snow"
          }
        }
      }
    },
    "Stagione": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Season"
          }
        }
      }
    },
    "Sul Dock": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the Dock"
          }
        }
      }
    },
    "Sulle finestre": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Windows"
          }
        }
      }
    },
    "Tutte le impostazioni della neve tornano come al primo avvio.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All snow settings go back to how they were at first launch."
          }
        }
      }
    },
    "Valori predefiniti": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default Values"
          }
        }
      }
    },
    "Velocità": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed"
          }
        }
      }
    },
    "Velocità di caduta": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fall Speed"
          }
        }
      }
    },
    "Vento": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wind"
          }
        }
      }
    },
    "Suoni": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds"
          }
        }
      }
    },
    "Volume": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume"
          }
        }
      }
    },
    "Riproduci i suoni": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play Sounds"
          }
        }
      }
    },
    "Togli le palle di neve": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the Snowballs"
          }
        }
      }
    },
    "Scuoti la palla di vetro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shake the Snow Globe"
          }
        }
      }
    },
    "Per fare una palla di neve, tieni premuto ⌥ e passa il cursore sulla neve posata.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To make a snowball, hold ⌥ and move the pointer through settled snow."
          }
        }
      }
    },
    "Acceso: parte dal Dock. Spento: parte dalla finestra più in alto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: it starts on the Dock. Off: it starts on the highest window."
          }
        }
      }
    },
    "Fai clic sui rami per appendere le palline. Trascina l'albero per spostarlo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the branches to add baubles. Drag the tree to move it."
          }
        }
      }
    },
    "Lancia lo slittino trascinandolo, o fai clic per spingerlo: scende di bordo in bordo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the sled to throw it, or click to push it: it slides down from edge to edge."
          }
        }
      }
    },
    "Manda lo spazzaneve": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the Snowplough"
          }
        }
      }
    },
    "Metti in pausa i giochi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause the Toys"
          }
        }
      }
    },
    "Monta la funivia": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build a Cable Car"
          }
        }
      }
    },
    "Pianta un albero di Natale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put Up a Christmas Tree"
          }
        }
      }
    },
    "Prepara la pista da slittino": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a Sled Run"
          }
        }
      }
    },
    "Prima il Dock": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock First"
          }
        }
      }
    },
    "Pulisce il bordo su cui corre e scende di bordo in bordo. La neve raccolta resta in una montagnetta.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It clears the edge it drives on and drops down from edge to edge. The snow it gathers is left in a little heap."
          }
        }
      }
    },
    "Togli alberi, neve e slitte": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Trees, Snow Heaps and Sleds"
          }
        }
      }
    },
    "Togli la funivia": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the Cable Car"
          }
        }
      }
    },
    "Trascina il gancio sul bordo di una finestra: la cabina corre sul cavo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the hook onto the edge of a window: the cabin rides along the cable."
          }
        }
      }
    }
  }
}
