    "Diventa un file da mandare con AirDrop, Messaggi o Mail. Chi lo apre con Sbu Seasons se lo trova sullo schermo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It becomes a file to send with AirDrop, Messages or Mail. Whoever opens it with Sbu Seasons finds it on their screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird zu einer Datei, die du per AirDrop, Nachrichten oder Mail senden kannst. Wer sie mit Sbu Seasons öffnet, findet ihn auf dem Bildschirm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il devient un fichier à envoyer par AirDrop, Messages ou Mail. Qui l’ouvre avec Sbu Seasons le retrouve sur son écran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se convierte en un archivo para enviar por AirDrop, Mensajes o Mail. Quien lo abra con Sbu Seasons lo verá en su pantalla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop、メッセージ、メールで送れるファイルになります。Sbu Seasonsで開いた人の画面に現れます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vira um arquivo para enviar por AirDrop, Mensagens ou Mail. Quem abrir com o Sbu Seasons o encontra na tela."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wordt een bestand dat je met AirDrop, Berichten of Mail stuurt. Wie het met Sbu Seasons opent, vindt het op het scherm."
          }
        }
      }
    },
    "Questo file non si apre": {
