    "Lo sfondo segue l'ora del Mac: alba, giorno, tramonto, notte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wallpaper follows the Mac's clock: dawn, day, sunset, night."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrund folgt der Uhr des Mac: Morgengrauen, Tag, Sonnenuntergang, Nacht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fond d’écran suit l’horloge du Mac : aube, jour, coucher du soleil, nuit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fondo sigue la hora del Mac: alba, día, atardecer, noche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁紙はMacの時計に合わせて変わります。夜明け、昼、夕焼け、夜。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O fundo segue o relógio do Mac: alvorada, dia, pôr do sol, noite."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De achtergrond volgt de klok van de Mac: dageraad, dag, zonsondergang, nacht."
          }
        }
      }
    },
