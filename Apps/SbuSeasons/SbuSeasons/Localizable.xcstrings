    "Un filo di luci sotto la barra dei menu. Colori, forma e animazione sono nelle Impostazioni.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A string of lights under the menu bar. Colors, shape and animation are in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Lichterkette unter der Menüleiste. Farben, Form und Animation findest du in den Einstellungen."
          }
        },
