    "Scrivi un desiderio: la slitta passa e se lo porta via. Il testo non si salva.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a wish: the sleigh comes by and takes it away. The text is not saved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib einen Wunsch: Der Schlitten kommt vorbei und nimmt ihn mit. Der Text wird nicht gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris un souhait : le traîneau passe et l’emporte. Le texte n’est pas enregistré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un deseo: pasa el trineo y se lo lleva. El texto no se guarda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "願いごとを書いてください。ソリが通りかかって持っていきます。文章は保存されません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva um desejo: o trenó passa e o leva embora. O texto não é salvo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf een wens: de slee komt langs en neemt hem mee. De tekst wordt niet bewaard."
          }
        }
      }
    },
