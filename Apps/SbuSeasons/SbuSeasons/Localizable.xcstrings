    "Lo sfondo può seguire l'effetto, su tutti gli schermi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wallpaper can follow the effect, on every screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrund kann dem Effekt folgen, auf allen Bildschirmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fond d’écran peut suivre l’effet, sur tous les écrans."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fondo puede seguir al efecto, en todas las pantallas."
          }
        },
        "ja": {
