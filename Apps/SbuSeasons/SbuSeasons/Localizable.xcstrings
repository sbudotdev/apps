    "Un pannellino sulla scrivania con giorni, ore e minuti. Trascinalo dove vuoi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small panel on the desktop with days, hours and minutes. Drag it wherever you like."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kleine Tafel auf dem Schreibtisch mit Tagen, Stunden und Minuten. Zieh sie, wohin du willst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit panneau sur le bureau avec les jours, les heures et les minutes. Place-le où tu veux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panel pequeño en el escritorio con días, horas y minutos. Arrástralo adonde quieras."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日・時間・分を表示する小さなパネルをデスクトップに置きます。好きな場所にドラッグできます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um painel pequeno na mesa com dias, horas e minutos. Arraste para onde quiser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een paneeltje op het bureaublad met dagen, uren en minuten. Sleep het waar je maar wilt."
          }
        }
      }
    },
