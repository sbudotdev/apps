    "Hai già 10 immagini. Togline una per importarne un'altra.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have 10 images. Remove one to import another."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast schon 10 Bilder. Entferne eins, um ein anderes zu importieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as déjà 10 images. Retires-en une pour en importer une autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tienes 10 imágenes. Quita una para importar otra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像はすでに10枚あります。別の画像を読み込むには1枚取り除いてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já tem 10 imagens. Remova uma para importar outra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt al 10 afbeeldingen. Haal er een weg om een andere te importeren."
          }
        }
      }
    },
    "L'immagine supera i 20 MB. Scegline una più leggera.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is larger than 20 MB. Choose a smaller one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild ist größer als 20 MB. Wähle ein kleineres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image dépasse 20 Mo. Choisis-en une plus légère."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen supera los 20 MB. Elige una más ligera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像が20 MBを超えています。もっと小さい画像を選んでください。"
