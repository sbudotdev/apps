    "Pulisce il bordo su cui corre e scende di bordo in bordo. La neve raccolta resta in una montagnetta.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It clears the edge it drives on and drops down from edge to edge. The snow it gathers is left in a little heap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er räumt die Kante, auf der er fährt, und fährt von Kante zu Kante hinunter. Der gesammelte Schnee bleibt als kleiner Haufen liegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dégage le bord sur lequel il roule et descend de bord en bord. La neige ramassée reste en petit tas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia el borde por el que avanza y baja de borde en borde. La nieve que recoge queda en un montoncito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "走っている縁の雪をどけて、縁から縁へと下りていきます。集めた雪は小さな山になって残ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele limpa a borda por onde passa e desce de borda em borda. A neve recolhida fica num montinho."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij maakt de rand waarop hij rijdt schoon en rijdt van rand naar rand naar beneden. De verzamelde sneeuw blijft in een hoopje liggen."
          }
        }
      }
    },
    "Togli alberi, neve e slitte": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Trees, Snow Heaps and Sleds"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bäume, Schneehaufen und Schlitten entfernen"
          }
        },
        "fr": {
