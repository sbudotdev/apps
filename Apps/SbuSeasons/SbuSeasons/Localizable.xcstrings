    "L'ha fatto una versione più nuova di Sbu Seasons. Aggiorna l'app e riprova.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A newer version of Sbu Seasons made it. Update the app and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neuere Version von Sbu Seasons hat sie erstellt. Aktualisiere die App und versuch es noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version plus récente de Sbu Seasons l’a créé. Mets l’app à jour et réessaie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo hizo una versión más nueva de Sbu Seasons. Actualiza la app y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンのSbu Seasonsで作られています。アプリをアップデートしてもう一度試してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi feito por uma versão mais nova do Sbu Seasons. Atualize o app e tente de novo."
          }
        },
        "nl": {
