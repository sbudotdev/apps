    "Cammina sopra le finestre. Avvicina il cursore: il naso si illumina.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walks along the tops of your windows. Bring the pointer close and its nose lights up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft oben über deine Fenster. Bring den Zeiger näher, dann leuchtet seine Nase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marche sur le haut de tes fenêtres. Approche le pointeur : son nez s’allume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Camina por encima de las ventanas. Acerca el puntero: se le ilumina la nariz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウの上を歩きます。ポインタを近づけると鼻が光ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda por cima das janelas. Aproxime o ponteiro: o nariz se acende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopt over de bovenkant van je vensters. Kom dichterbij met de aanwijzer: zijn neus gaat branden."
          }
        }
      }
    },
    "Candela e luce bassa": {
      "localizations": {
