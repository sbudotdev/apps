    "Lo schermo si scurisce un po' e in basso a destra si accende una candela. Di sera vuol dire dall'ora scelta fino alle 6.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen dims a little and a candle lights up in the bottom right corner. In the evening means from the chosen hour until 6 am."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm wird etwas dunkler und unten rechts brennt eine Kerze. „Am Abend“ heißt ab der gewählten Uhrzeit bis 6 Uhr morgens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran s’assombrit un peu et une bougie s’allume en bas à droite. Le soir, c’est de l’heure choisie jusqu’à 6 h."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla se oscurece un poco y abajo a la derecha se enciende una vela. Por la noche significa desde la hora elegida hasta las 6."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面が少し暗くなり、右下でろうそくが灯ります。「夜に」は、選んだ時刻から朝6時までです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela escurece um pouco e uma vela se acende no canto inferior direito. À noite quer dizer da hora escolhida até as 6."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het scherm wordt wat donkerder en rechtsonder gaat een kaars branden. ’s Avonds betekent vanaf het gekozen uur tot 6 uur ’s ochtends."
          }
        }
      }
    },
