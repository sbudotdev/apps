          "stringUnit": {
            "state": "translated",
            "value": "De afbeelding is groter dan 20 MB. Kies een kleinere."
          }
        }
      }
    },
    "Il file non si apre come immagine. Prova con un PNG, un JPEG, un HEIC o un SVG.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file doesn't open as an image. Try a PNG, JPEG, HEIC or SVG."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei lässt sich nicht als Bild öffnen. Versuche es mit PNG, JPEG, HEIC oder SVG."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier ne s'ouvre pas comme une image. Essaie un PNG, un JPEG, un HEIC ou un SVG."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no se abre como imagen. Prueba con un PNG, JPEG, HEIC o SVG."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは画像として開けません。PNG、JPEG、HEIC、SVGを試してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não abre como imagem. Tente um PNG, JPEG, HEIC ou SVG."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand gaat niet open als afbeelding. Probeer een PNG, JPEG, HEIC of SVG."
          }
        }
      }
    },
    "Importa le tue immagini in Impostazioni → Le tue immagini.": {
