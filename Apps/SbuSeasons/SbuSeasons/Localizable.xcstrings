    "Finder, Safari e Note hanno angoli più tondi di Chrome. Se la neve resta sospesa sugli angoli, aumenta; se entra nella finestra, diminuisci.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder, Safari and Notes have rounder corners than Chrome. If snow hangs in the air at the corners, increase it; if it falls into the window, decrease it."
          }
        }
      }
    },
    "Forte": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heavy"
          }
        }
      }
    },
