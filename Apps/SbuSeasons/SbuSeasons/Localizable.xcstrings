    "Trascina il gancio sul bordo di una finestra: la cabina corre sul cavo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the hook onto the edge of a window: the cabin rides along the cable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh den Haken auf den Rand eines Fensters: Die Kabine fährt am Seil entlang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser le crochet sur le bord d’une fenêtre : la cabine file le long du câble."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el gancho al borde de una ventana: la cabina recorre el cable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フックをウインドウの縁までドラッグしてください。ゴンドラがケーブルを走ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o gancho até a borda de uma janela: a cabine corre pelo cabo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de haak naar de rand van een venster: de cabine rijdt langs de kabel."
          }
        }
      }
    },
