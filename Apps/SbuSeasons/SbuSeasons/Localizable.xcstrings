    "Un elfo esce dalla neve, rotola tre palle e fa un pupazzo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An elf comes out of the snow, rolls three balls and builds a snowman."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Elf kommt aus dem Schnee, rollt drei Kugeln und baut einen Schneemann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lutin sort de la neige, roule trois boules et fait un bonhomme de neige."
          }
        },
        "es": {
          "stringUnit": {
