      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always"
          }
        }
      }
    },
    "Volpe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fox"
          }
        }
      }
    },
    "Sfondi…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallpapers…"
          }
        }
      }
    },
    "Sfondi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallpapers"
          }
        }
      }
    },
    "Dieci sfondi per la scrivania, ognuno con il suo effetto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten desktop wallpapers, each with its own effect."
          }
        }
      }
    },
    "Prima neve": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First Snow"
          }
        }
      }
    },
    "Baita nel bosco": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabin in the Woods"
          }
        }
      }
    },
    "Lago ghiacciato": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frozen Lake"
          }
        }
      }
    },
    "Funivia": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cable Car"
          }
        }
