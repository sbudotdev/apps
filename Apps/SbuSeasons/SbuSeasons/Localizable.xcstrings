    "Gli sfondi cambiano con l'ora: alba, mattina, tramonto, notte e gli altri momenti.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallpapers change with the time: dawn, morning, sunset, night and the moments in between."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hintergründe ändern sich mit der Uhrzeit: Morgengrauen, Morgen, Sonnenuntergang, Nacht und alles dazwischen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonds d’écran changent avec l’heure : aube, matin, coucher du soleil, nuit et les moments entre les deux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fondos cambian con la hora: alba, mañana, atardecer, noche y los momentos intermedios."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁紙は時刻に合わせて変わります。夜明け、朝、夕焼け、夜、そしてその間の時間帯。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os fundos mudam com a hora: alvorada, manhã, pôr do sol, noite e os momentos entre eles."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De achtergronden veranderen met de tijd: dageraad, ochtend, zonsondergang, nacht en de momenten daartussen."
          }
        }
      }
    },
    "Il salvaschermo con gli sfondi del borgo: lo installi dalle Impostazioni.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A screen saver with the village wallpapers: install it from Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bildschirmschoner mit den Hintergründen des Dorfs: Du installierst ihn in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’économiseur d’écran avec les fonds du village : installe-le depuis les Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El salvapantallas con los fondos del pueblo: lo instalas desde Ajustes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "村の壁紙を使ったスクリーンセーバー。設定からインストールできます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O protetor de tela com os fundos do vilarejo: instale nos Ajustes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schermbeveiliging met de achtergronden van het dorp: installeer hem in Instellingen."
          }
        }
      }
    },
