    "Finder, Safari e Note hanno angoli più tondi di Chrome. Se la neve resta sospesa sugli angoli, aumenta; se entra nella finestra, diminuisci.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder, Safari and Notes have rounder corners than Chrome. If snow hangs in the air at the corners, increase it; if it falls into the window, decrease it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder, Safari und Notizen haben rundere Ecken als Chrome. Wenn der Schnee an den Ecken in der Luft hängt, erhöhe den Wert; wenn er ins Fenster fällt, verringere ihn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder, Safari et Notes ont des coins plus arrondis que Chrome. Si la neige reste suspendue aux coins, augmente ; si elle tombe dans la fenêtre, diminue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder, Safari y Notas tienen esquinas más redondeadas que Chrome. Si la nieve se queda flotando en las esquinas, aumenta; si entra en la ventana, disminuye."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder、Safari、メモはChromeより角が丸くなっています。角の上で雪が宙に浮いて見えたら大きく、ウインドウの中に落ちるなら小さくしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder, Safari e Notas têm cantos mais arredondados que o Chrome. Se a neve fica suspensa nos cantos, aumente; se ela entra na janela, diminua."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder, Safari en Notities hebben rondere hoeken dan Chrome. Blijft de sneeuw bij de hoeken in de lucht hangen, verhoog dan; valt hij in het venster, verlaag dan."
          }
        }
      }
    },
