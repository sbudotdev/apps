          }
        }
      }
    },
    "Da provare adesso": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try These Now"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probier das gleich aus"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À essayer maintenant"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para probar ahora"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ試してみよう"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para experimentar agora"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer dit nu"
          }
        }
      }
    },
    "Dal 1° dicembre al 6 gennaio Babbo Natale passa ogni tanto e lascia un regalo. Nel menu Natale ci sono anche l'omino di pan di zenzero e il conto alla rovescia.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From 1 December to 6 January, Santa passes by now and then and leaves a present. The Christmas menu also has the gingerbread man and the countdown."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom 1. Dezember bis 6. Januar kommt ab und zu der Weihnachtsmann vorbei und lässt ein Geschenk da. Im Menü Weihnachten gibt es außerdem den Lebkuchenmann und den Countdown."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du 1er décembre au 6 janvier, le père Noël passe de temps en temps et laisse un cadeau. Le menu Noël propose aussi le bonhomme en pain d’épice et le compte à rebours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Del 1 de diciembre al 6 de enero, Papá Noel pasa de vez en cuando y deja un regalo. En el menú Navidad también están el hombre de jengibre y la cuenta atrás."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12月1日から1月6日まで、サンタがときどきやって来てプレゼントを置いていきます。クリスマスメニューには、ジンジャーブレッドマンとカウントダウンもあります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "De 1º de dezembro a 6 de janeiro, o Papai Noel passa de vez em quando e deixa um presente. No menu Natal também estão o boneco de gengibre e a contagem regressiva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van 1 december tot 6 januari komt de kerstman af en toe langs en laat hij een cadeau achter. In het menu Kerst vind je ook het peperkoekmannetje en het aftellen."
          }
        }
      }
    },
    "Di sera lo schermo si scurisce un po' e in basso a destra si accende una candela. Scegli quando dal menu di Sbu Seasons → Notte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the evening the screen dims a little and a candle lights up at the bottom right. Choose when from the Sbu Seasons menu → Night."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Abend wird der Bildschirm etwas dunkler und unten rechts brennt eine Kerze. Wann, wählst du im Menü von Sbu Seasons → Nacht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soir, l’écran s’assombrit un peu et une bougie s’allume en bas à droite. Choisis quand dans le menu de Sbu Seasons → Nuit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por la noche la pantalla se oscurece un poco y abajo a la derecha se enciende una vela. Elige cuándo en el menú de Sbu Seasons → Noche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜になると画面が少し暗くなり、右下でろうそくが灯ります。いつにするかはSbu Seasonsのメニュー → 夜 で選べます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "À noite a tela escurece um pouco e uma vela se acende no canto inferior direito. Escolha quando no menu do Sbu Seasons → Noite."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "’s Avonds wordt het scherm wat donkerder en rechtsonder gaat een kaars branden. Kies wanneer in het menu van Sbu Seasons → Nacht."
          }
        }
      }
    },
    "Dieci sfondi disegnati per Sbu Seasons, ognuno con il suo effetto. Se vuoi gli effetti solo sulla scrivania, accendi Dietro le finestre.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten wallpapers drawn for Sbu Seasons, each with its own effect. If you want the effects on the desktop only, turn on Behind Windows."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zehn Hintergründe, gezeichnet für Sbu Seasons, jeder mit seinem eigenen Effekt. Wenn du die Effekte nur auf dem Schreibtisch willst, schalte „Hinter den Fenstern“ ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dix fonds d’écran dessinés pour Sbu Seasons, chacun avec son effet. Si tu veux les effets seulement sur le bureau, active Derrière les fenêtres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diez fondos dibujados para Sbu Seasons, cada uno con su efecto. Si quieres los efectos solo en el escritorio, activa Detrás de las ventanas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbu Seasonsのために描いた10枚の壁紙で、それぞれにエフェクトが付いています。エフェクトをデスクトップだけにしたいときは、「ウインドウの後ろ」をオンにしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dez fundos desenhados para o Sbu Seasons, cada um com seu efeito. Se quiser os efeitos só na mesa, ative Atrás das janelas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tien achtergronden getekend voor Sbu Seasons, elk met een eigen effect. Wil je de effecten alleen op het bureaublad, zet dan Achter vensters aan."
          }
        }
      }
    },
    "Dietro le finestre": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Behind Windows"
          }
        },
