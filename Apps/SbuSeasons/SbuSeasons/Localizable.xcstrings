    "L'elfo lascia un regalo: dentro c'è qualcosa per l'albero o il pupazzo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The elf leaves a present: inside there is something for the tree or the snowman."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Elf lässt ein Geschenk da: Darin ist etwas für den Baum oder den Schneemann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lutin laisse un cadeau : dedans, il y a quelque chose pour le sapin ou le bonhomme de neige."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El elfo deja un regalo: dentro hay algo para el árbol o el muñeco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "妖精がプレゼントを置いていきます。中にはツリーか雪だるまに使えるものが入っています。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O elfo deixa um presente: dentro há algo para a árvore ou o boneco."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De elf laat een cadeau achter: daarin zit iets voor de boom of de sneeuwpop."
          }
        }
      }
    },
