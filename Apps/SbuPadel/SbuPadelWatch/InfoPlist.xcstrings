          "stringUnit" : {
            "state" : "translated",
            "value" : "Sbu Padel legge battito e calorie dell'allenamento della partita. I dati restano in Salute, sul tuo orologio e sul tuo iPhone."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "The Health permission prompt: saves each match as a tennis workout.",
