{
  "sourceLanguage": "it",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "The app name under the icon.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbu Clean"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbu Clean"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "The Photos permission prompt. Everything stays on the device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbu Clean looks at your photos and videos to find duplicates, screenshots and heavy files. Everything stays on this iPhone: nothing leaves the device."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbu Clean guarda le tue foto e i tuoi video per trovare duplicati, screenshot e file pesanti. Tutto resta su questo iPhone: niente lascia il dispositivo."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbu Clean reads your contacts to find people saved twice and merge them when you ask. Everything stays on this iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbu Clean legge i tuoi contatti per trovare le persone salvate due volte e unirle quando lo chiedi tu. Tutto resta su questo iPhone."
          }
        }
      }
    }
  },
  "version": "1.0"
}