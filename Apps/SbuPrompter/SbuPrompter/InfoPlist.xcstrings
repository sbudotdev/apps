      }
    },
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbu Prompter"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbu Prompter"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbu Prompter listens to your voice to scroll the script as you read. The audio stays on the Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbu Prompter ascolta la tua voce per far scorrere il copione mentre leggi. L'audio resta sul Mac."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbu Prompter recognizes words on the Mac, without the network, to follow the point of the script you are reading."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbu Prompter riconosce le parole sul Mac, senza rete, per seguire il punto del copione che stai leggendo."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbu Prompter lets your iPhone find it on Wi-Fi, so you can use it as a remote. Nothing leaves your home network."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbu Prompter si fa trovare dal tuo iPhone sulla Wi-Fi, per usarlo come telecomando. Nulla esce dalla rete di casa."
          }
        }
      }
    }
  },
  "version": "1.0"
}