    "La classe Euro è sul libretto, al campo V.9. Non chiedo la targa: resta tutto sul tuo iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Euro class is on the registration document, field V.9. I don't ask for the plate: everything stays on your iPhone."
          }
        }
      }
    },
