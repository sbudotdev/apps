    "Domenica ecologica: veicoli e deroghe li decide ogni volta un'ordinanza. Segui la segnaletica.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecological Sunday: an ordinance sets vehicles and exceptions each time. Follow the signs."
          }
        }
      }
    },
