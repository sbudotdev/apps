            "value" : "End the block"
          }
        }
      }
    },
    "Tieni il telefono fuori dalla camera da letto: la sveglia la fa anche una sveglia." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your phone out of the bedroom: an alarm clock wakes you too."
          }
        }
      }
    },
    "Togli le notifiche delle app che apri per noia: resta quello che ti serve davvero." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off notifications for the apps you open out of boredom: what you really need stays."
          }
        }
      }
    },
    "Toglie l'ultimo giorno che ha interrotto la serie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes the last day that broke the streak."
          }
        }
      }
    },
    "Tutte le app si chiudono per il tempo che scegli, tranne le App consentite." : {
